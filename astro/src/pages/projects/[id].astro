---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';

export async function getStaticPaths(){
  return (await getCollection('projects')).map(entry=>({params:{id:entry.id},props:{entry}}));
}

const {entry}=Astro.props;
const {Content}=await render(entry);
const statusLabels={'Idé':'Planerat projekt','Pågående':'Aktiv pilot','Klart':'Publicerat'};
---
<Base title={entry.data.title+' — Solvinter'}><article class="project"><p class="eyebrow">Projects / {statusLabels[entry.data.status]}</p><h1>{entry.data.title}</h1><Content/><a href="/sv/#projects">← Alla projekt</a></article></Base>
