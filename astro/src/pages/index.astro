---
import Base from '../layouts/Base.astro';
import ghana from '../data/ghana.json';
import {getCollection} from 'astro:content';

const projectTranslations={"Ett tjänsteerbjudande för utvärdering av medicinska AI-system utvecklas.": "A service for evaluating medical AI systems is in development.", "En AI-guide för att lära genom att göra, nu i en liten pilot i Ghana genom Solvinter Tech.": "A guided AI companion for learning by doing, now being tested in a small Ghana pilot through Solvinter Tech.", "Medicin, metabolism och bioteknologisk utveckling.": "Medicine, metabolism and biotechnology development.", "Öppna data, AI och ekonomisk analys för att identifiera möjligheter.": "Open data, AI and economic analysis to identify opportunities."};
const projects=(await getCollection('projects')).map(p=>({...p,data:{...p.data,description:projectTranslations[p.data.description]||p.data.description}}));
const projectStatusLabels={
  'Idé':'Planned project ↗',
  'Pågående':'Active pilot ↗',
  'Klart':'Published ↗',
};
---
<Base><section class="hero"><p class="eyebrow">An independent atelier · Solvinter</p><h1>Look closer.<br/><em>Think further.</em></h1><div class="intro"><p>A growing place for medicine, philosophy, AI and art. For questions that need time, and ideas worth bringing into being.</p><a class="textlink" href="#projects">Explore the work ↗</a></div><div class="orbital" aria-hidden="true"><span></span></div></section><section class="photo"><img src={ghana[2].src} alt="Beach in warm evening light, from Dominic’s Ghana selection"/><div class="caption"><span>From the photographic archive / Ghana</span><span>Dominic Eriksson Giwa · from ghana_selection</span></div></section><section id="about" class="split about"><p class="eyebrow">About</p><div><h2>About Solvinter</h2><p>Solvinter is an independent initiative working across medicine, artificial intelligence, philosophy and the arts.</p><p>Founded by Dominic Eriksson Giwa, a Swedish physician exploring the intersection of human knowledge and emerging technologies.</p><div class="about-contact"><p class="eyebrow">Contact</p><a class="contact-email" href="mailto:hello@solvinter.com">hello@solvinter.com</a><a class="contact-github" href="https://github.com/solvinter" target="_blank" rel="noopener noreferrer" aria-label="Solvinter on GitHub (opens in a new tab)">GitHub — solvinter ↗</a></div></div></section><section id="ghana-pilot" class="split"><p class="eyebrow">Now / Ghana</p><div><h2>A pilot in practice.</h2><p>Solvinter is working with a small group of participants in Ghana to explore how Eira, practical assignments and shared reflection can support learning and creative work.</p><p>Participation remains limited while the format is tested and improved.</p><a class="textlink" href="/en/projects/eira/">Read about Eira ↗</a></div></section><section id="projects"><div class="sectionhead"><p class="eyebrow">Projects</p><h2>Questions in progress.</h2><p class="small">One active pilot, alongside longer-term projects in development.</p></div>{projects.map((p)=><a class="row" href={'/en/projects/'+p.id+'/'}><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="status">{projectStatusLabels[p.data.status]}</span></a>)}</section><section id="art" class="split art"><div><p class="eyebrow">Art</p><h2>Collection 001</h2><p>69 photographs from Ghana. An artistic selection by Dominic Eriksson Giwa, brought together in Collection 001.</p><p class="small">The selection is the photographer’s.</p><a class="textlink" href="/en/art/collection-001/">View the collection · compare three layouts ↗</a></div><div><h3>Anomaliernas kosmologi</h3><p>A literary work. A presentation is being prepared under Art.</p></div></section><section id="essays" class="split"><p class="eyebrow">Essays</p><div><h2>Room for thought.</h2><p>Philosophy, medicine, psychiatric nosology, AI and the philosophy of science. This will be a home for completed and reviewed essays.</p><p class="small">The first publication is being prepared.</p></div></section><section id="atelje" class="split"><p class="eyebrow">Ateljé</p><div><h2>Before it is ready.</h2><p>The atelier holds work in progress, sketches and experiments. We are currently building the foundations for the photographic archive and Collection 001.</p><p class="small">The private selection tool runs separately on the local computer. Images and decisions stay on the device.</p></div></section><section id="work" class="work"><p class="eyebrow">Work</p><h2>Medical knowledge.<br/><em>New tools.</em></h2><p>Services in development for medical and research-related assignments.</p><div class="services"><p>Clinical AI evaluation</p><p>Medical research & literature review</p><p>Medical writing & fact checking</p><p>AI-assisted research workflows</p></div><p class="small">First proposed work sample: a focused evaluation of a medical AI system, including an assessment framework, error analysis and report. Contact details and terms will be added after review.</p><div class="compute-profile"><p class="eyebrow">Sol 1 / Compute resource</p><h3>Local AI and GPU computing.</h3><p>Sol 1 is a local workstation with an NVIDIA RTX 4090 and 24 GB of VRAM, intended for prototyping, evaluation and selected local-model workloads within Solvinter. It is an internal resource, not a public cloud service, and external access is not currently offered.</p><table><caption>Sol 1 · Hardware</caption><tbody><tr><th scope="row">Processor</th><td>AMD Ryzen 7 7800X3D</td></tr><tr><th scope="row">Cores / threads</th><td>8 / 16</td></tr><tr><th scope="row">Maximum frequency</th><td>5.05 GHz</td></tr><tr><th scope="row">L3 cache</th><td>96 MB</td></tr><tr><th scope="row">Graphics card</th><td>NVIDIA RTX 4090</td></tr><tr><th scope="row">VRAM</th><td>24 GB</td></tr><tr><th scope="row">Operating system</th><td>Ubuntu 24.04.4 LTS</td></tr></tbody></table></div></section></Base>
