---
import '../styles.css';
const pathname = Astro.url.pathname;
const en = pathname === '/' || pathname.startsWith('/en/');
const home = ['/', '/en/', '/sv/'].includes(pathname);
const navHome = en ? '/' : '/sv/';
const svPath = home ? '/sv/' : en ? pathname.slice(3) || '/' : pathname;
const enPath = home ? '/' : en ? pathname : '/en' + pathname;
const {title=en?'Solvinter — a place for inquiry':'Solvinter — en plats för undersökande',description=en?'Opportunity, learning and creativity. An independent atelier for ideas and work that can grow.':'Möjligheter, lärande och skapande. En oberoende ateljé för idéer och arbeten som får växa.'}=Astro.props;
const canonicalPath = pathname === '/en/' ? '/' : pathname;
const canonicalURL = new URL(canonicalPath, 'https://solvinter.org');
const identity = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type':'Organization','@id':'https://solvinter.org/#organization',name:'Solvinter',legalName:'SOLVINTER LTD',url:'https://solvinter.org/',sameAs:['https://github.com/solvinter']},
    {'@type':'WebSite','@id':'https://solvinter.org/#website',name:'Solvinter',url:'https://solvinter.org/',publisher:{'@id':'https://solvinter.org/#organization'},inLanguage:['en','sv']}
  ]
};
---
<!doctype html><html lang={en?'en':'sv'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonicalURL}/>{home&&<script type="application/ld+json" set:html={JSON.stringify(identity)}/>}<meta name="robots" content="index,follow"/><link rel="alternate" hreflang="sv" href={svPath}/><link rel="alternate" hreflang="en" href={enPath}/></head><body class:list={{'winter-home':home}}><a class="skip" href="#main">{en?'Skip to content':'Till innehållet'}</a><div class:list={{'winter-banner':home}}>{home&&<><img class="winter-landscape" src="/images/winter-sun.jpg" alt={en?'Low winter sun over a snowy landscape':'Låg vintersol över ett snötäckt landskap'} width="4032" height="3024" fetchpriority="high"/><div class="winter-shade" aria-hidden="true"></div></>}<header><a class="brand" href={navHome}>◌ SOLVINTER</a><div class="header-links"><nav aria-label={en?'Main navigation':'Huvudnavigation'}>{[['Home','/'],['Essays','/#essays'],['Projects','/#projects'],['Art','/#art'],['Ateljé','/#atelje'],['About','/#about']].map(([label,url])=><a href={navHome+url.slice(1)}>{label}</a>)}</nav><div class="languages" role="group" aria-label={en?'Language and access':'Språk och tillgänglighet'}><a class="language-link" href={enPath} hreflang="en" lang="en" aria-label="English" title="English" aria-current={en?'true':undefined}><span aria-hidden="true">🇬🇧</span></a><a class="language-link" href={svPath} hreflang="sv" lang="sv" aria-label="Svenska" title="Svenska" aria-current={!en?'true':undefined}><span aria-hidden="true">🇸🇪</span></a><button type="button" class="language-link ghana-language-trigger" aria-label={en?'Ghana: language project in development':'Ghana: språkprojekt under utveckling'} title={en?'Ghana — project in development':'Ghana — projekt under utveckling'} aria-haspopup="dialog" aria-controls="ghana-language-dialog"><span aria-hidden="true">🇬🇭</span></button></div></div></header></div><dialog id="ghana-language-dialog" class="ghana-language-dialog" aria-labelledby="ghana-language-title"><p class="eyebrow">{en?'Ghana / Language access':'Ghana / Språktillgänglighet'}</p><h2 id="ghana-language-title">{en?'Language access — Ghana':'Språk och kommunikation — Ghana'}</h2><p>{en?"We are exploring ways to make Eira and Solvinter accessible in the languages spoken across Ghana.":"Vi undersöker hur Eira och Solvinter kan bli tillgängliga på de språk som talas i Ghana."}</p><p>{en?"Our long-term ambition is to support Ghana’s linguistic diversity, including regional languages and dialects, so that more people can learn, communicate and participate in the digital economy in their own language.":"Vår långsiktiga ambition är att stödja Ghanas språkliga mångfald, inklusive regionala språk och dialekter, så att fler människor kan lära, kommunicera och delta i den digitala ekonomin på sitt eget språk."}</p><p class="small">{en?'Project in development. No Ghanaian-language interface is available yet.':'Projekt under utveckling. Något gränssnitt på ghananska språk finns ännu inte.'}</p><form method="dialog"><button class="ghana-dialog-close" type="submit">{en?'Close':'Stäng'}</button></form></dialog><main id="main"><slot/></main><footer><span>© 2026 Solvinter™ · SOLVINTER LTD</span><span>{en?'Opportunity · Learning · Creativity':'Möjligheter · Lärande · Skapande'}</span><a href="mailto:hello@solvinter.org">hello@solvinter.org</a></footer><script>
function syncLanguageLinks(){for(const link of document.querySelectorAll<HTMLAnchorElement>('.language-link'))link.hash=window.location.hash;}
syncLanguageLinks();window.addEventListener('hashchange',syncLanguageLinks);
const ghanaLanguageTrigger=document.querySelector<HTMLButtonElement>('.ghana-language-trigger');
const ghanaLanguageDialog=document.querySelector<HTMLDialogElement>('#ghana-language-dialog');
ghanaLanguageTrigger?.addEventListener('click',()=>ghanaLanguageDialog?.showModal());
</script></body></html>
