---
import '../styles.css';
const en=Astro.url.pathname.startsWith('/en/');
const prefix=en?'/en':'';
const home=['/','/en/'].includes(Astro.url.pathname);
const svPath=en?Astro.url.pathname.slice(3)||'/':Astro.url.pathname;
const {title=en?'Solvinter — a place for inquiry':'Solvinter — en plats för undersökande',description=en?'Medicine, philosophy, AI and art. An independent atelier for ideas and work that can grow.':'Medicin, filosofi, AI och konst. En oberoende ateljé för idéer och arbeten som får växa.'}=Astro.props;
---
<!doctype html><html lang={en?'en':'sv'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow"/><link rel="alternate" hreflang="sv" href={svPath}/><link rel="alternate" hreflang="en" href={'/en'+svPath}/></head><body class:list={{'winter-home':home}}><a class="skip" href="#main">{en?'Skip to content':'Till innehållet'}</a><div class:list={{'winter-banner':home}}>{home&&<><img class="winter-landscape" src="/images/winter-sun.jpg" alt={en?'Low winter sun over a snowy landscape':'Låg vintersol över ett snötäckt landskap'} width="4032" height="3024" fetchpriority="high"/><div class="winter-shade" aria-hidden="true"></div></>}<header><a class="brand" href={prefix+'/'}>◌ SOLVINTER</a><div class="header-links"><nav aria-label={en?'Main navigation':'Huvudnavigation'}>{[['Home','/'],['Essays','/#essays'],['Projects','/#projects'],['Art','/#art'],['Ateljé','/#atelje'],['About','/#about'],['Work','/#work']].map(([label,url])=><a href={prefix+url}>{label}</a>)}</nav><div class="languages" role="group" aria-label={en?'Language':'Språk'}><a class="language-link" href={svPath} hreflang="sv" lang="sv" aria-label="Svenska" title="Svenska" aria-current={!en?'true':undefined}><span aria-hidden="true">🇸🇪</span></a><a class="language-link" href={'/en'+svPath} hreflang="en" lang="en" aria-label="English" title="English" aria-current={en?'true':undefined}><span aria-hidden="true">🇬🇧</span></a></div></div></header></div><main id="main"><slot/></main><footer><span>© 2026 Solvinter</span><span>{en?'Medicine · Philosophy · Technology · Art':'Medicin · Filosofi · Teknologi · Konst'}</span><a href="mailto:hello@solvinter.com">hello@solvinter.com</a></footer><script>
function syncLanguageLinks(){for(const link of document.querySelectorAll<HTMLAnchorElement>('.language-link'))link.hash=window.location.hash;}
syncLanguageLinks();window.addEventListener('hashchange',syncLanguageLinks);
</script></body></html>
